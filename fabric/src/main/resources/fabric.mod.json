{
  "schemaVersion": 1,
  "id": "workingvillagers",
  "version": "${version}",
  "name": "Working Villagers",
  "description": "Hire unemployed villagers with a work contract and give them real jobs: lumberjacks fell and replant trees, sawyers and stone sawyers cut wood and stone, carpenters craft wooden goods and carriers move items between chests. Every worker earns a daily wage in emeralds.",
  "authors": [
    "TeaJay"
  ],
  "contact": {
    "homepage": "https://d4rkm0nkey.github.io/minecraft-working-villagers/",
    "sources": "https://github.com/d4rkm0nkey/minecraft-working-villagers",
    "issues": "https://github.com/d4rkm0nkey/minecraft-working-villagers/issues"
  },
  "license": "MIT",
  "icon": "assets/workingvillagers/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "me.teajay.workingvillagers.fabric.WorkingVillagersFabric"
    ],
    "client": [
      "me.teajay.workingvillagers.fabric.WorkingVillagersFabricClient"
    ]
  },
  "mixins": [
    "workingvillagers.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "java": ">=${java_version}",
    "minecraft": "${minecraft_dependency}",
    "fabric-api": ">=${fabric_version}"
  }
}
